# ──────────────────────────────────────────────────────────────
# Project Singularity — Environment Variables
# Copy this file to .env and fill in any overrides you need.
# Docker Compose reads .env automatically.
# ──────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────
DB_URL=jdbc:mysql://mysql:3306/singularity?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USER=singularity
DB_PASSWORD=singularity_pass

# ── API ───────────────────────────────────────────────────────
CORS_ALLOWED_ORIGIN=http://localhost:5173
AUTO_APPROVE=false
SURGE_THRESHOLD=4
LOW_STOCK_THRESHOLD=20

# ── Razorpay (TEST keys — no real money involved) ────────────
# Replace these with your own test keys from https://dashboard.razorpay.com
RAZORPAY_KEY_ID=rzp_test_TSVn4GUskMHl0f
RAZORPAY_KEY_SECRET=9Doe4GPdNwz5qj0xnNjEZbnR
RAZORPAY_WEBHOOK_SECRET=singularity_secret_123

# ── Edge Node ─────────────────────────────────────────────────
# These are read from config/zones.json, not env vars,
# but listed here for reference:
# SAMPLE_INTERVAL_SECONDS=5
# HTTP_TIMEOUT=5
